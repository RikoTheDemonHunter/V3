--// Step 1: Core Foundation

local Services = {}

Services.Players = game:GetService("Players")
Services.TweenService = game:GetService("TweenService")
Services.UserInputService = game:GetService("UserInputService")
Services.RunService = game:GetService("RunService")
Services.HttpService = game:GetService("HttpService")

local Player = Services.Players.LocalPlayer


--// Config System

local Config = {}

Config.FileName = "AveryHubV4_Config.json"
Config.Data = {
    Theme = "Ethereal Blue",
    Style = "Default",
    Settings = {}
}


function Config:Load()
    if isfile and readfile and isfile(self.FileName) then
        
        local success,result = pcall(function()
            return Services.HttpService:JSONDecode(
                readfile(self.FileName)
            )
        end)

        if success and type(result) == "table" then
            self.Data = result
        end
    end
end


function Config:Save()

    if writefile then

        pcall(function()
            writefile(
                self.FileName,
                Services.HttpService:JSONEncode(self.Data)
            )
        end)

    end
end


Config:Load()



--// Connection Manager

local Connections = {}


function Connections:Add(connection)

    table.insert(
        Connections,
        connection
    )

    return connection
end


function Connections:Clear()

    for _,connection in pairs(Connections) do

        pcall(function()
            connection:Disconnect()
        end)

    end

    table.clear(Connections)

end



--// Theme Engine

local Theme = {

    Background = Color3.fromRGB(15,15,25),
    Sidebar = Color3.fromRGB(10,10,18),

    Accent = Color3.fromRGB(0,200,255),

    Text = Color3.fromRGB(255,255,255),

    Success = Color3.fromRGB(0,220,130),

    Error = Color3.fromRGB(255,80,80)

}


local ThemeManager = {}


ThemeManager.Colors = {

