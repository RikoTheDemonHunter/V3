local SETTINGS_FILE = "AveryHubV4_Config.json"
local Config = {
    FileName = SETTINGS_FILE,
    Data = {
        Theme = "Ethereal Blue",
        Style = "Default",
        Settings = {}
    }
}

function Config:Load()
    if isfile and readfile and isfile(self.FileName) then
        local success, result = pcall(function()
            return HttpService:JSONDecode(readfile(self.FileName))
        end)
        if success and type(result) == "table" then
            self.Data = result
        end
    end
end

function Config:Save()
    if writefile then
        pcall(function()
            writefile(self.FileName, HttpService:JSONEncode(self.Data))
        end)
    end
end

Config:Load()

--------------------------------------------------
-- Connection Manager
--------------------------------------------------

local Connections = {}

function Connections:Add(connection)
    table.insert(Connections, connection)
    return connection
end

function Connections:Clear()
    for _, connection in pairs(Connections) do
        pcall(function() connection:Disconnect() end)
    end
    table.clear(Connections)
end

