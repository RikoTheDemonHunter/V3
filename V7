    close.TextColor3 = Theme.Text
    close.Font = Enum.Font.GothamBold
    close.Parent = main
    Instance.new("UICorner", close)

    local mini = Instance.new("TextButton")
    mini.Size = UDim2.new(0, 50, 0, 50)
