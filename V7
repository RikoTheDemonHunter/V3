    mini.Text = "⚡"
    mini.Visible = false
    mini.BackgroundColor3 = Theme.Background
    mini.TextColor3 = Theme.Accent
    mini.Font = Enum.Font.GothamBold
    mini.TextSize = 25
    mini.Parent = gui
    Instance.new("UICorner", mini)

    close.MouseButton1Click:Connect(function()
        main.Visible = false
        mini.Visible = true
    end)

    mini.MouseButton1Click:Connect(function()
        main.Visible = true
        mini.Visible = false
    end)

    -- Drag System
    local dragging, dragStart, startPos
    main.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = main.Position
        end
    end)
    main.InputEnded:Connect(function() dragging = false end)

    Connections:Add(UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end))

    local sidebar = Instance.new("Frame")
    sidebar.Size = UDim2.new(0, 150, 1, -70)
    sidebar.Position = UDim2.new(0, 10, 0, 55)
    sidebar.BackgroundColor3 = Theme.Sidebar
    sidebar.Parent = main
    Instance.new("UICorner", sidebar)

    local content = Instance.new("Frame")
    content.Size = UDim2.new(1, -175, 1, -70)
    content.Position = UDim2.new(0, 165, 0, 55)
    content.BackgroundTransparency = 1
    content.Parent = main

    local tabs = {}
    local currentPage

    function tabs:Add(name)
        local button = Instance.new("TextButton")
        button.Size = UDim2.new(1, -10, 0, 35)
        button.Text = name
        button.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
        button.TextColor3 = Theme.Text
        button.Font = Enum.Font.GothamSemibold
        button.Parent = sidebar
        Instance.new("UICorner", button)

        local page = Instance.new("ScrollingFrame")
        page.Size = UDim2.new(1, 0, 1, 0)
        page.Visible = false
        page.BackgroundTransparency = 1
        page.ScrollBarThickness = 3
        page.Parent = content

        local layout = Instance.new("UIListLayout")
        layout.Padding = UDim.new(0, 8)
        layout.Parent = page

        button.MouseButton1Click:Connect(function()
            if currentPage then currentPage.Visible = false end
            page.Visible = true
            currentPage = page
        end)

        if not currentPage then
            currentPage = page
            page.Visible = true
        end

        local elements = {}

        function elements:Button(text, callback)
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(1, -5, 0, 38)
            b.Text = text
            b.BackgroundColor3 = Color3.fromRGB(30, 30, 45)
            b.TextColor3 = Theme.Accent
            b.Font = Enum.Font.GothamSemibold
            b.Parent = page
            Instance.new("UICorner", b)
            b.MouseButton1Click:Connect(callback)
        end

        function elements:Toggle(text, callback)
            local state = Config.Data.Settings[text] or false
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(1, -5, 0, 38)
            b.Text = text .. " : " .. (state and "ON" or "OFF")
            b.BackgroundColor3 = Color3.fromRGB(30, 30, 45)
            b.TextColor3 = state and Theme.Success or Theme.Error
            b.Font = Enum.Font.GothamSemibold
            b.Parent = page
            Instance.new("UICorner", b)

            if state then task.spawn(callback, true) end

            b.MouseButton1Click:Connect(function()
                state = not state
                Config.Data.Settings[text] = state
                Config:Save()

                b.Text = text .. " : " .. (state and "ON" or "OFF")
                b.TextColor3 = state and Theme.Success or Theme.Error
                task.spawn(callback, state)
            end)
        end

        function elements:Label(text)
            local l = Instance.new("TextLabel")
            l.Size = UDim2.new(1, -5, 0, 30)
            l.Text = text
            l.BackgroundTransparency = 1
            l.TextColor3 = Theme.Text
            l.Font = Enum.Font.Gotham
            l.Parent = page
            return l
        end

        return elements
    end

    getgenv().AveryV4.UI = tabs
    return gui
end

UI:Create()

