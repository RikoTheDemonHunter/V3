            Instance.new("UIListLayout")

        layout.Padding =
            UDim.new(0,8)

        layout.Parent = page



        button.MouseButton1Click:Connect(function()

            if currentPage then
                currentPage.Visible = false
            end

            page.Visible = true
            currentPage = page

        end)



        if not currentPage then
            currentPage = page
            page.Visible = true
        end



        local elements = {}



        function elements:Button(text,callback)

            local b =
                Instance.new("TextButton")

            b.Size =
                UDim2.new(1,-5,0,38)

            b.Text=text

            b.BackgroundColor3 =
