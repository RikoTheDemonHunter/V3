		TabAccent.Position = UDim2.new(0, 5, 0, 6)
		TabAccent.BackgroundColor3 = Theme.Accent
		TabAccent.BorderSizePixel = 0
		TabAccent.Visible = false
		TabAccent.Parent = TabBtn
		makeCorner(TabAccent, 99)
