)



--// Responsive Scaling

local function ApplyScale(gui)

    local scale =
        Instance.new("UIScale")

    local camera =
        workspace.CurrentCamera


    local size =
        camera.ViewportSize.X


    scale.Scale =
        math.clamp(
            size / 1200,
            0.65,
            1.25
        )


    scale.Parent = gui


    Services.UserInputService
    .WindowFocused:Connect(function()

        scale.Scale =
            math.clamp(
                workspace.CurrentCamera.ViewportSize.X / 1200,
                0.65,
                1.25
            )

    end)

    return scale

end



