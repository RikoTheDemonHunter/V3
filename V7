local Core = getgenv().AveryV4

local Modules = {}

Modules.List = {}



--// Register Module

function Modules:Register(name, callback)

    self.List[name] = {

        Enabled = false,
        Start = callback

    }

end



--// Enable Module

function Modules:Enable(name)

    local module = self.List[name]

    if not module then
        warn("Module not found:", name)
        return
    end


    if module.Enabled then
        return
    end


    module.Enabled = true


    local success,err = pcall(function()

        module.Start(true)

    end)


    if not success then
        warn(
            "Module Error:",
            name,
            err
        )
    end

end



--// Disable Module

function Modules:Disable(name)

    local module = self.List[name]

    if module then

        module.Enabled = false

        pcall(function()

            module.Start(false)

        end)

    end

end



--// Toggle Module

function Modules:Toggle(name,state)

    if state then

        self:Enable(name)

    else

        self:Disable(name)

    end

end



