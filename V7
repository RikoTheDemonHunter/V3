	local accentObjects = {}
	local activePage
	local activeTabButton
	local activeConnection

	local function registerAccent(obj, prop)
		table.insert(accentObjects, {Obj = obj, Prop = prop})
		obj[prop] = Theme.Accent
	end

	local function applyAccent(color)
		Theme.Accent = color
		for _, item in ipairs(accentObjects) do
			if item.Obj and item.Obj.Parent then
				item.Obj[item.Prop] = color
			end
		end
	end

	local function StartCycleAccent(mode)
		if activeConnection then
			activeConnection:Disconnect()
			activeConnection = nil
		end
		activeConnection = RunService.RenderStepped:Connect(function()
			local color
			if mode == "Rainbow" then
				color = Color3.fromHSV((tick() % 4) / 4, 1, 1)
			elseif mode == "Ethereal" then
				local s = (math.sin(tick() * 1.2) + 1) / 2
				color = Color3.fromRGB(0, 170, 255):Lerp(Color3.fromRGB(255, 100, 200), s)
			end
			if color then
				Theme.Accent = color
				for _, item in ipairs(accentObjects) do
					if item.Obj and item.Obj.Parent then
						item.Obj[item.Prop] = color
					end
				end
			end
		end)
	end

