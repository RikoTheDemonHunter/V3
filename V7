pcall(function()
    local Players = game:GetService("Players")
    local TweenService = game:GetService("TweenService")
    local HttpService = game:GetService("HttpService")
    local UserInputService = game:GetService("UserInputService")
    local LocalPlayer = Players.LocalPlayer

    -- Check R15
    if not LocalPlayer.Character or LocalPlayer.Character:WaitForChild("Humanoid").RigType ~= Enum.HumanoidRigType.R15 then 
        game:GetService("StarterGui"):SetCore("SendNotification", {Title = "R6 Error", Text = "You are on R6. Please switch to R15!", Duration = 10})
        return
    end

    local cloneref = cloneref or function(o) return o end
    local CoreGui = cloneref(game:GetService("CoreGui")) or LocalPlayer:WaitForChild("PlayerGui")

    -- Clean up previous execution
    local oldGui = CoreGui:FindFirstChild("GazeVerificator") or CoreGui:FindFirstChild("DraggableGui")
    if oldGui then oldGui:Destroy() end

    -- Custom Notification System
    local Notifbro = {}
    local function Notify(titletxt, text, time)
        coroutine.wrap(function()
            local GUI = Instance.new("ScreenGui")
            GUI.Name = "BackgroundNotif"
            GUI.Parent = CoreGui

            local sw = workspace.CurrentCamera.ViewportSize.X
            local sh = workspace.CurrentCamera.ViewportSize.Y
            local nh = sh / 7
            local nw = sw / 5

            local Main = Instance.new("Frame", GUI)
            Main.Name = "MainFrame"
            Main.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
            Main.BackgroundTransparency = 0.2
            Main.BorderSizePixel = 0
            Main.Size = UDim2.new(0, nw, 0, nh)

            local title = Instance.new("TextLabel", Main)
            title.Size = UDim2.new(1, 0, 0, nh / 2)
            title.Font = Enum.Font.GothamBold
            title.Text = titletxt
            title.TextColor3 = Color3.new(1, 1, 1)
            title.TextScaled = true
            title.BackgroundTransparency = 0.9
            title.BackgroundColor3 = Color3.new(0,0,0)

            local message = Instance.new("TextLabel", Main)
            message.Position = UDim2.new(0, 0, 0, nh / 2)
            message.Size = UDim2.new(1, 0, 1, -nh / 2)
            message.Font = Enum.Font.Gotham
            message.Text = text
            message.TextColor3 = Color3.new(1, 1, 1)
            message.TextScaled = true
            message.BackgroundTransparency = 1

            local offset = 50
            for _, notif in ipairs(Notifbro) do
                offset = offset + notif.Size.Y.Offset + 10
            end

            Main.Position = UDim2.new(1, 5, 0, offset)
            table.insert(Notifbro, Main)

            task.wait(0.1)
            Main:TweenPosition(UDim2.new(1, -nw, 0, offset), Enum.EasingDirection.Out, Enum.EasingStyle.Bounce, 0.4, true)
            task.wait(time or 3)

            Main:TweenPosition(UDim2.new(1, 5, 0, offset), Enum.EasingDirection.In, Enum.EasingStyle.Bounce, 0.4, true)
            task.wait(0.4)
            GUI:Destroy()

            for i, notif in ipairs(Notifbro) do
                if notif == Main then
                    table.remove(Notifbro, i)
                    break
                end
            end
        end)()
    end

    -- Persistent Active Pack State
    local SelectedPack = nil

    local function ApplyAnimationPack(char, packName)
        if not char or not packName then return end
        local animateScript = char:WaitForChild("Animate", 5)
        local humanoid = char:WaitForChild("Humanoid", 5)
        if not animateScript or not humanoid then return end

        -- Stop currently playing tracks to avoid overlap bugs
        for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
            track:Stop()
        end

        -- Update Animate Script IDs
        local function setAnim(folderName, id)
            local folder = animateScript:FindFirstChild(folderName)
            if folder then
                for _, anim in ipairs(folder:GetChildren()) do
                    if anim:IsA("Animation") then
                        anim.AnimationId = "rbxassetid://" .. tostring(id)
                    end
                end
            end
        end

        -- Apply Selected Pack IDs dynamically
        for category, anims in pairs(OriginalAnimations) do
            if anims[packName] then
                local animData = anims[packName]
                if category == "Idle" and type(animData) == "table" then
                    setAnim("idle", animData[1])
                else
                    setAnim(category:lower(), animData)
                end
            end
        end

        -- Refresh Humanoid State to force animation update
        humanoid:ChangeState(Enum.HumanoidStateType.Landed)
    end

    -- Keep Animation Active Across Respawns
    LocalPlayer.CharacterAdded:Connect(function(newChar)
        if SelectedPack then
            task.wait(1) -- Allow character load
            ApplyAnimationPack(newChar, SelectedPack)
        end
    end)

    -- Build Main UI
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "GazeVerificator"
    screenGui.Parent = CoreGui

    local camera = workspace.CurrentCamera
    local function getScaledSize(rw, rh)
        return UDim2.new(0, math.floor(camera.ViewportSize.X * rw), 0, math.floor(camera.ViewportSize.Y * rh))
    end

    local frame = Instance.new("Frame")
    frame.Name = "GazeMain"
    frame.Size = getScaledSize(0.3, 0.4)
    frame.Position = UDim2.new(0.5, -frame.Size.X.Offset/2, 0.5, -frame.Size.Y.Offset/2)
    frame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Draggable = true
    frame.Parent = screenGui

    -- Close Button (X)
    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0, 30, 0, 30)
    closeBtn.Position = UDim2.new(1, -35, 0, 5)
    closeBtn.Text = "X"
    closeBtn.Font = Enum.Font.SourceSansBold
    closeBtn.TextSize = 18
    closeBtn.TextColor3 = Color3.fromRGB(255, 80, 80)
    closeBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    closeBtn.BorderSizePixel = 0
    closeBtn.Parent = frame

    closeBtn.MouseButton1Click:Connect(function()
        frame.Visible = false
        Notify("Gaze", "Press Right-Control to open again!", 2)
    end)

    -- Toggle Menu Visibility with Right Control
    UserInputService.InputBegan:Connect(function(input, gpe)
        if not gpe and input.KeyCode == Enum.KeyCode.RightControl then
            frame.Visible = not frame.Visible
        end
    end)

    local gazeLabel = Instance.new("TextLabel")
    gazeLabel.Text = "GAZE ANIMATOR"
    gazeLabel.Font = Enum.Font.SourceSansBold
    gazeLabel.TextScaled = true
    gazeLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    gazeLabel.BackgroundTransparency = 1
    gazeLabel.Size = UDim2.new(0.7, 0, 0.1, 0)
    gazeLabel.Position = UDim2.new(0.05, 0, 0, 0)
    gazeLabel.Parent = frame

    local searchBar = Instance.new("TextBox")
    searchBar.PlaceholderText = "Search animations..."
    searchBar.Font = Enum.Font.SourceSans
    searchBar.TextScaled = true
    searchBar.TextColor3 = Color3.fromRGB(220, 220, 220)
    searchBar.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    searchBar.BorderSizePixel = 0
    searchBar.Size = UDim2.new(0.9, 0, 0.12, 0)
    searchBar.Position = UDim2.new(0.05, 0, 0.12, 0)
    searchBar.Parent = frame

    local scrollFrame = Instance.new("ScrollingFrame")
    scrollFrame.Size = UDim2.new(0.9, 0, 0.7, 0)
    scrollFrame.Position = UDim2.new(0.05, 0, 0.26, 0)
    scrollFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    scrollFrame.BorderSizePixel = 0
    scrollFrame.ScrollBarThickness = 4
    scrollFrame.Parent = frame

    local scrollLayout = Instance.new("UIListLayout")
    scrollLayout.SortOrder = Enum.SortOrder.LayoutOrder
    scrollLayout.Padding = UDim.new(0, 4)
    scrollLayout.Parent = scrollFrame

    scrollLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        scrollFrame.CanvasSize = UDim2.new(0, 0, 0, scrollLayout.AbsoluteContentSize.Y)
    end)

    -- Populate Animation Packs List
    local createdSet = {}
    local buttons = {}

    local function createPackButton(packName)
        if createdSet[packName] then return end
        createdSet[packName] = true

        local button = Instance.new("TextButton")
        button.Text = packName
        button.Font = Enum.Font.SourceSansBold
        button.TextSize = 16
        button.TextColor3 = Color3.fromRGB(240, 240, 240)
        button.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
        button.Size = UDim2.new(1, 0, 0, 35)
        button.BorderSizePixel = 0
        button.Parent = scrollFrame

        button.MouseButton1Click:Connect(function()
            SelectedPack = packName
            ApplyAnimationPack(LocalPlayer.Character, packName)
            Notify("Applied", packName .. " animations loaded!", 2)
        end)

        table.insert(buttons, button)
    end

    -- Load all unique pack names from idle category
    for name, _ in pairs(OriginalAnimations["Idle"]) do
        createPackButton(name)
    end

    searchBar:GetPropertyChangedSignal("Text"):Connect(function()
        local filter = searchBar.Text:lower()
        for _, btn in ipairs(buttons) do
            btn.Visible = (filter == "" or btn.Text:lower():find(filter, 1, true) ~= nil)
        end
    end)

    Notify("Gaze Loaded", "Press Right-Control to hide/show UI.", 4)
end)
