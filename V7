-- Button Helper
local function createTheButton(name, onClick)
    local button = Instance.new("TextButton")
    button.Name = name
    button.Size = UDim2.new(1, -10, 0, 35)
    button.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
    button.Text = name .. " Pack"
    button.TextColor3 = Color3.fromRGB(220, 220, 220)
    button.TextSize = 15
    button.Font = Enum.Font.SourceSansBold
    button.Parent = ScrollFrame

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = button

    button.MouseButton1Click:Connect(onClick)
    return button
end

-- Filter Logic
SearchBar:GetPropertyChangedSignal("Text"):Connect(function()
    local searchText = SearchBar.Text:lower()
    for _, child in pairs(ScrollFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child.Visible = (searchText == "" or child.Name:lower():find(searchText) ~= nil)
        end
    end
end)

-- Core Function to apply the chosen package to character's Animate script
local function applyPackage(packageName, packData)
    local animateScript = Character:FindFirstChild("Animate")
    if not animateScript then
        Notify("Error", "Animate script missing from Character!", 3)
        return
    end

    for category, ids in pairs(packData) do
        local targetFolder = animateScript:FindFirstChild(category)
        if targetFolder then
            targetFolder:ClearAllChildren()
            for i, id in ipairs(ids) do
                local newAnim = Instance.new("Animation")
                newAnim.Name = category .. "Anim" .. i
                newAnim.AnimationId = "rbxassetid://" .. id
                newAnim.Parent = targetFolder

                local weightVal = Instance.new("NumberValue")
                weightVal.Name = "Weight"
                weightVal.Value = (i == 1 and 10 or 1)
                weightVal.Parent = newAnim
            end
        end
    end

    -- Force Humanoid to update animation state immediately
    local humanoid = Character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid:ChangeState(Enum.HumanoidStateType.Landed)
    end

    Notify("Applied", "Equipped " .. packageName .. " Package!", 2)
end

-- Populate buttons for all available animation packages
for packName, packData in pairs(AnimationPacks) do
    createTheButton(packName, function()
        applyPackage(packName, packData)
    end)
end
